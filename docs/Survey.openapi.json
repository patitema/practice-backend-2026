    "/surveys/{id}/questions": {
      "post": {
        "summary": "Добавить вопрос к опросу",
        "deprecated": false,
        "description": "Добавляет новый вопрос к опросу.\n\n### Типы вопросов\n\n| Тип | Описание | Требуемые данные |\n|-----|----------|------------------|\n| `single_choice` | Один вариант из нескольких | `options` (массив вариантов) |\n| `multiple_choice` | Несколько вариантов | `options` (массив вариантов) |\n| `text_answer` | Текстовый ответ | Не требуется |\n\n### Ограничения\n\n- Можно добавлять вопросы только к опросам в статусе **draft**\n- Поле `required` определяет, обязательно ли отвечать на вопрос",
        "tags": [
          "Questions"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID опроса",
            "required": true,
            "example": 0,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "single_choice",
                      "multiple_choice",
                      "text_answer"
                    ],
                    "description": "Тип вопроса",
                    "example": "single_choice"
                  },
                  "text": {
                    "type": "string",
                    "description": "Текст вопроса",
                    "example": "Какой ваш любимый цвет?"
                  },
                  "order": {
                    "type": "integer",
                    "description": "Порядок отображения",
                    "example": 1
                  },
                  "required": {
                    "type": "boolean",
                    "description": "Обязательный ли вопрос",
                    "example": true
                  }
                }
              },
              "example": {
                "type": "single_choice",
                "text": "Какой ваш любимый цвет?",
                "order": 1,
                "required": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Вопрос успешно создан",
            "headers": {}
          },
          "403": {
            "description": "Доступ запрещён или опрос опубликован",
            "headers": {}
          },
          "422": {
            "description": "Ошибка валидации",
            "headers": {}
          }
        },
        "security": [
